APP_ENV=production
PORT=8000
DATABASE_URL_FILE=/run/secrets/treseko_database_url
SECRET_KEY_FILE=/run/secrets/treseko_secret_key
ENGINE_URL=http://engine:3010
MCP_RUNTIME_RESOLVER_URL=http://backend:8000/mcp/internal/runtime-credential
MCP_RUNTIME_RESOLVER_ALLOWED_ORIGINS=http://backend:8000
MCP_RUNTIME_RESOLVER_TRUSTED_PRIVATE_ORIGINS=http://backend:8000
REDIS_URL=redis://redis:6379/0
TRESEKO_MCP_ENABLED=false
TRESEKO_MCP_TOOLS=
TRESEKO_MCP_DEPLOYMENT_TOPOLOGY=single_process

# No habilitar flags TRESEKO_ALLOW_DEV_* en produccion.
# No guardar DATABASE_URL ni SECRET_KEY inline en archivos productivos.
# IPs/CIDRs de proxies que pueden aportar X-Forwarded-For a la auditoría.
# TRESEKO_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Los keyrings publicos oficiales se embeben en el build de release.
MCP_RUNTIME_RESOLVER_ALLOW_INSECURE_HTTP=false
