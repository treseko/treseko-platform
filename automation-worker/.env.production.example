NODE_ENV=production
QA_API_BASE=http://backend:8000
# UUID de la solucion/organizacion a la que se vincula el worker.
QA_ORGANIZACION_ID=
# El token se guarda en este archivo despues de aprobar la solicitud de pairing.
# No guardar el token en este ejemplo ni en compose.production.env.
QA_RUNNER_TOKEN_FILE=/worker/.runner-token
QA_POLL_INTERVAL_MS=5000
