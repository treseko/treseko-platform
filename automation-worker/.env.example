QA_API_BASE=http://localhost:9095/api
QA_RUNNER_TOKEN_FILE=.runner-token
QA_RUNNER_NAME=Local Playwright Worker
# UUID de la solucion/organizacion donde se vincula este worker.
# En V1 el worker no es global de instancia.
QA_ORGANIZACION_ID=
QA_POLL_INTERVAL_MS=3000
QA_HEARTBEAT_INTERVAL_MS=10000
QA_REQUEST_TIMEOUT_MS=10000
QA_HEADLESS=true
QA_MAX_PARALLEL_JOBS=1
QA_RUNNER_TAGS=local,v1,playwright,puppeteer,cypress,selenium
QA_PYTHON_BIN=python
