{
  "name": "treseko-automation-worker",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"if (process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD) { console.log('Skipping Playwright browser install'); process.exit(0) } process.exit(1)\" || playwright install chromium",
    "test": "node --test src/*.test.mjs",
    "start": "node src/worker.mjs",
    "once": "node src/worker.mjs --once",
    "install:browsers": "playwright install chromium && cypress install"
  },
  "dependencies": {
    "cypress": "^15.19.0",
    "playwright": "^1.60.0",
    "postman-collection": "^5.1.0",
    "postman-runtime": "^7.56.1",
    "puppeteer": "^23.11.1",
    "tsx": "^4.19.2"
  }
}
