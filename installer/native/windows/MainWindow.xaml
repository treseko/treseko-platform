<Window x:Class="TresekoInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador Treseko Community" Height="610" Width="780"
        MinHeight="560" MinWidth="700" WindowStartupLocation="CenterScreen">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Treseko Community" FontSize="27" FontWeight="SemiBold" Foreground="#17243B"/>
      <TextBlock Text="Instalador nativo para Windows" Margin="0,4,0,0" Foreground="#596982"/>
    </StackPanel>
    <GroupBox Grid.Row="1" Header="Versiones y estado" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="LatestVersionText" Text="Consultando el último release público…" FontWeight="SemiBold"/>
        <TextBlock x:Name="RuntimeText" Text="Comprobando la instalación local…" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="InstallerUpdateText" Margin="0,6,0,0" Foreground="#596982" TextWrapping="Wrap"/>
      </StackPanel>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="Instalación" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Puerto local" VerticalAlignment="Center"/>
        <TextBox x:Name="PortInput" Grid.Column="1" Text="9095" Width="100" HorizontalAlignment="Left"/>
        <Button Grid.Column="2" Content="Comprobar" Padding="12,5" Click="Check_Click"/>
        <TextBlock Grid.Row="1" Text="Instalación existente" VerticalAlignment="Center" Margin="0,12,0,0"/>
        <TextBox x:Name="InstallRootInput" Grid.Row="1" Grid.Column="1" Margin="0,12,8,0" IsReadOnly="True"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Seleccionar…" Margin="0,12,0,0" Padding="12,5" Click="ChooseRoot_Click"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="ModeText" Margin="0,12,0,0" Foreground="#596982" TextWrapping="Wrap"/>
      </Grid>
    </GroupBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
      <Button x:Name="SelfUpdateButton" Content="Actualizar instalador" Padding="14,8" Margin="0,0,8,0" Click="SelfUpdate_Click" IsEnabled="False"/>
      <Button x:Name="InstallButton" Content="Instalar Treseko" Padding="18,8" Background="{StaticResource TresekoBlue}" Foreground="White" Click="Install_Click"/>
    </StackPanel>
    <ProgressBar Grid.Row="4" x:Name="Progress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
    <GroupBox Grid.Row="5" Header="Actividad" Padding="10">
      <TextBox x:Name="ActivityText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" BorderThickness="0"/>
    </GroupBox>
    <TextBlock Grid.Row="6" Text="Las actualizaciones preservan los volúmenes y secretos existentes. Si no se puede confirmar la instalación, la operación se bloquea." Margin="0,12,0,0" Foreground="#596982" TextWrapping="Wrap"/>
  </Grid>
</Window>
