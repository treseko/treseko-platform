# Treseko Community self-hosted release
TRESEKO_HTTP_PORT=9095

# Los secretos reales viven fuera del repositorio.
DB_USER=treseko
DB_NAME=treseko
TRESEKO_DB_PASSWORD_FILE=/opt/treseko/secrets/db-password
TRESEKO_DATABASE_URL_FILE=/opt/treseko/secrets/database-url
TRESEKO_SECRET_KEY_FILE=/opt/treseko/secrets/secret-key
TRESEKO_AI_CREDENTIALS_MASTER_KEY_FILE=/opt/treseko/secrets/ai-credentials-master-key
TRESEKO_AI_ENGINE_INTERNAL_TOKEN_FILE=/opt/treseko/secrets/ai-engine-internal-token
# Opcional. No se envía el ping de instalación salvo activación del administrador.
TRESEKO_ENABLE_INSTALLATION_PING=false
# La tienda oficial remota está fuera de alcance en Community 1.0.
TRESEKO_PLUGIN_STORE_ENABLED=false
CORS_ALLOWED_ORIGINS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
LOG_LEVEL=INFO

AI_ALLOWED_LLM_HOSTS=
AI_API_ENDPOINT=
AI_MODEL=
QA_TEST_TRACE_ENABLED=false
QA_ORGANIZACION_ID=
QA_POLL_INTERVAL_MS=5000
TRESEKO_UPDATE_DB_HISTORY_ENABLED=true
TRESEKO_UPDATE_STEP_TIMEOUT_SECONDS=300
TRESEKO_COMMUNITY_UPDATE_CHANNEL=community-stable
